.m-main-product .m-local-fulfillment {
  display: flex;
  flex-direction: column;
  margin-top: 20px;
  padding: 0;
  border: 1px solid #e5e5e5;
  border-radius: 12px;
  overflow: hidden;
  background: #ffffff;
}

.m-local-fulfillment .m-local-fulfillment__row {
  display: flex;
  align-items: center;
  gap: 10px;
  width: 100%;
  margin: 0;
  padding: 14px;
  border: 0;
  background: transparent;
  color: #555555;
  font-family: var(--font-stack-body);
  font-size: 14px;
  font-weight: 400;
  line-height: 1.5;
  text-align: left;
}

.m-local-fulfillment .m-local-fulfillment__pickup {
  border-bottom: 1px solid #e5e5e5;
  cursor: pointer;
}

.m-local-fulfillment__uber {
  cursor: pointer;
}

.m-local-fulfillment__pickup:hover,
.m-local-fulfillment__uber:hover {
  background: #f7f7f7;
  color: #111111;
}

.m-local-fulfillment__pickup:focus-visible,
.m-local-fulfillment__uber:focus-visible {
  outline: 2px solid #111111;
  outline-offset: -3px;
}

.m-local-fulfillment__row span {
  flex: 1;
  min-width: 0;
}

.m-local-fulfillment .m-local-fulfillment__icon,
.m-local-fulfillment .m-local-fulfillment__arrow {
  flex-shrink: 0;
  width: 20px;
  height: 20px;
  margin: 0;
  fill: none;
  stroke: currentColor;
  stroke-width: 1.5;
  stroke-linecap: round;
  stroke-linejoin: round;
  color: #111111;
}

.m-local-fulfillment .m-local-fulfillment__arrow {
  width: 16px;
  height: 16px;
}

.m-uber-delivery-drawer__product {
  margin: 0 0 16px;
  font-size: 16px;
  font-weight: 500;
}

.m-uber-delivery-drawer__description {
  margin: 0;
  font-size: 14px;
  line-height: 1.6;
}

.m-uber-delivery-drawer__actions {
  display: grid;
  gap: 12px;
  margin-top: 24px;
}

.m-uber-delivery-drawer__action {
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: 48px;
  padding: 12px 16px;
  border: 1px solid #111111;
  border-radius: 8px;
  background: #ffffff;
  color: #111111;
  font-size: 14px;
  font-weight: 500;
  text-align: center;
}

.m-uber-delivery-drawer__action--call {
  background: #111111;
  color: #ffffff;
}

.m-uber-delivery-drawer__action--whatsapp {
  border-color: #25d366;
  background: #25d366;
}

.m-uber-delivery-drawer__action:hover {
  border-color: #111111;
  background: #eeeeee;
  color: #111111;
}

.m-uber-delivery-drawer__action:focus-visible {
  outline: 2px solid currentColor;
  outline-offset: 3px;
}

.main-product__block-custom_liquid .ap-mini-banner,
.installment-shoppay shopify-payment-terms {
  font-family: var(--font-stack-body);
  font-size: 14px;
  line-height: 1.4;
  color: #777777;
}

.main-product__block-custom_liquid button.ap-logo {
  padding: 0;
  border: 0;
  background: transparent;
  cursor: pointer;
}

.m-main-product .main-product__block-custom_liquid:has(.ap-mini-banner) {
  margin-top: 12px;
}

.main-product__block-custom_liquid button.ap-logo:focus-visible,
.ap-popup button:focus-visible {
  outline: 2px solid currentColor;
  outline-offset: 3px;
}

dialog.ap-popup {
  width: 432px;
  max-width: calc(100% - 32px);
  max-height: calc(100dvh - 32px);
  margin: auto;
  padding: 0;
  border: 0;
  border-radius: 28px;
  background: #ffffff;
  color: #111111;
  font-family: var(--font-stack-body);
  text-align: left;
  box-shadow: 0 12px 48px #00000026;
  overscroll-behavior: contain;
}

.ap-popup::backdrop {
  background: #00000080;
}

.ap-popup__header {
  display: flex;
  justify-content: flex-end;
  padding: 16px 16px 8px;
}

.ap-popup__close {
  display: flex;
  padding: 0;
  border: 0;
  border-radius: 50%;
  background: transparent;
  color: #555555;
  cursor: pointer;
}

.ap-popup__content {
  padding: 0 32px 32px;
}

.ap-popup__title {
  margin: 0 0 16px;
  color: #111111;
  font-family: var(--font-stack-body);
  font-size: 22px;
  font-weight: 700;
  line-height: 1.3;
}

.ap-popup__image {
  display: block;
  width: 100%;
  height: auto;
  border-radius: 8px;
}

.ap-popup__checkout {
  display: block;
  width: 100%;
  margin-top: 16px;
  padding: 12px 16px;
  border: 0;
  border-radius: 8px;
  background: #000000;
  color: #ffffff;
  font-family: var(--font-stack-body);
  font-size: 14px;
  font-weight: 600;
  line-height: 1.4;
  cursor: pointer;
}

.ap-popup__checkout:hover {
  background: #333333;
}

.ap-popup__checkout:disabled {
  opacity: 0.6;
  cursor: wait;
}

.ap-popup__error {
  margin: 12px 0 0;
  color: #c62828;
  font-size: 14px;
  line-height: 1.4;
}

@media screen and (max-width: 480px) {
  dialog.ap-popup {
    width: 100%;
    max-width: 100%;
    max-height: calc(100dvh - env(safe-area-inset-top, 0px));
    margin: auto 0 0;
    border-radius: 28px 28px 0 0;
  }

  .ap-popup__content {
    padding: 0 24px calc(24px + env(safe-area-inset-bottom, 0px));
  }
}

@media screen and (max-width: 767px) {
  .m-header__mobile {
    padding-top: 8px;
    padding-bottom: 8px;
    max-height: 56px;
  }

  .m-header__mobile .m-logo__image img,
  .m-header__mobile .m-logo__image svg {
    max-height: 32px;
    height: auto;
    width: auto;
  }

  .m-header__mobile .m-svg-icon--medium {
    width: 20px;
    height: 20px;
  }
}

/* Styles moved from the theme editor's custom CSS settings. */
.m-section__subheading,
.m-richtext__subtitle {
  font-weight: 500;
  font-size: 18px;
}

.m-section__header {
  --m-section-header-spacing-bottom: 40px;
}

.m-button--link {
  --btn-link-border: 1px;
}

.m-logo__image {
  position: relative;
  padding-top: 24px;
  padding-bottom: 20px;
}

.m-header__inner {
  height: 74px;
}

.m-sub-menu--level-1 {
  flex-direction: column;
  flex-wrap: wrap;
  height: 550px;
  align-content: flex-start;
}

.m-show-menu-column-divider .m-sub-menu__item--level-1 {
  padding-left: 0;
  border-left: none;
}

.m-menu__link--main:after {
  background-color: #c19967;
}

.m-menu__item--mega .m-sub-menu__item--level-1 {
  margin-bottom: 0;
}

.m-menu__item--mega .m-mega-menu__column {
  margin-top: 0;
}

.m-sub-menu__item > a {
  padding-top: 0;
}

.m-sub-menu {
  padding-bottom: 20px;
}

.main-product__block-inventory_status {
  display: none;
}

.m-modal--content {
  border-radius: 12px;
}

.m-menu__item--dropdown .m-mega-menu__column {
  background-color: #eeeeee;
}

/* popup sign up form */
.lg-outer .lg-video {
  height: 100% !important;
}

.lg-video-cont {
  height: 670px;
}

@media (max-width: 1024px) {
  .lg-video-cont {
    height: 600px;
  }
}

.m-article__feature-image {
  max-height: 300px;
}

@media only screen and (max-width: 767px) {
  ._grid_1q1d2_148 {
    display: block;
  }
}
