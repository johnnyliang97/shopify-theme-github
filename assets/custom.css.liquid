{% comment %}
  All custom CSS in this file will be kept when updating the theme
  Write your custom CSS below
{% endcomment %}

.main-product__block-custom_liquid .ap-mini-banner,
.installment-shoppay shopify-payment-terms {
  font-family: var(--font-stack-body);
  font-size: 14px;
  line-height: 1.4;
  color: #777777;
}

.main-product__block-custom_liquid button.ap-logo {
  padding: 0;
  border: 0;
  background: transparent;
  cursor: pointer;
}

.m-main-product .main-product__block-custom_liquid:has(.ap-mini-banner) {
  margin-top: 12px;
}

.main-product__block-custom_liquid button.ap-logo:focus-visible,
.ap-popup button:focus-visible {
  outline: 2px solid currentColor;
  outline-offset: 3px;
}

dialog.ap-popup {
  width: 432px;
  max-width: calc(100% - 32px);
  max-height: calc(100dvh - 32px);
  margin: auto;
  padding: 0;
  border: 0;
  border-radius: 28px;
  background: #ffffff;
  color: #111111;
  font-family: var(--font-stack-body);
  text-align: left;
  box-shadow: 0 12px 48px #00000026;
  overscroll-behavior: contain;
}

.ap-popup::backdrop {
  background: #00000080;
}

.ap-popup__header {
  display: flex;
  justify-content: flex-end;
  padding: 16px 16px 8px;
}

.ap-popup__close {
  display: flex;
  padding: 0;
  border: 0;
  border-radius: 50%;
  background: transparent;
  color: #555555;
  cursor: pointer;
}

.ap-popup__content {
  padding: 0 32px 32px;
}

.ap-popup__title {
  margin: 0 0 16px;
  color: #111111;
  font-family: var(--font-stack-body);
  font-size: 22px;
  font-weight: 700;
  line-height: 1.3;
}

.ap-popup__image {
  display: block;
  width: 100%;
  height: auto;
  border-radius: 8px;
}

.ap-popup__checkout {
  display: block;
  width: 100%;
  margin-top: 16px;
  padding: 12px 16px;
  border: 0;
  border-radius: 8px;
  background: #000000;
  color: #ffffff;
  font-family: var(--font-stack-body);
  font-size: 14px;
  font-weight: 600;
  line-height: 1.4;
  cursor: pointer;
}

.ap-popup__checkout:hover {
  background: #333333;
}

.ap-popup__checkout:disabled {
  opacity: 0.6;
  cursor: wait;
}

.ap-popup__error {
  margin: 12px 0 0;
  color: #c62828;
  font-size: 14px;
  line-height: 1.4;
}

@media screen and (max-width: 480px) {
  dialog.ap-popup {
    width: 100%;
    max-width: 100%;
    max-height: calc(100dvh - env(safe-area-inset-top, 0px));
    margin: auto 0 0;
    border-radius: 28px 28px 0 0;
  }

  .ap-popup__content {
    padding: 0 24px calc(24px + env(safe-area-inset-bottom, 0px));
  }
}

@media screen and (max-width: 767px) {
  .m-header__mobile {
    padding-top: 8px;
    padding-bottom: 8px;
    max-height: 56px;
  }

  .m-header__mobile .m-logo__image img,
  .m-header__mobile .m-logo__image svg {
    max-height: 32px;
    height: auto;
    width: auto;
  }

  .m-header__mobile .m-svg-icon--medium {
    width: 20px;
    height: 20px;
  }
}
