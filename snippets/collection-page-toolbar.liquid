{%- assign st = section.settings -%}

{%- liquid
  assign show_columns_switcher = st.show_columns_switcher
  assign sidebar_position = sidebar_position | default: st.sidebar
  assign active_filter_count = 0
  if st.filters_type == 'tags_filter'
    assign active_filter_count = current_tags.size
  else
    for filter in results.filters
      if template.name == 'collection' and filter.param_name == 'filter.v.availability'
        continue
      endif
      assign active_filter_count = active_filter_count | plus: filter.active_values.size
      if filter.type == 'price_range'
        if filter.min_value.value != nil or filter.max_value.value != nil
          assign active_filter_count = active_filter_count | plus: 1
        endif
      endif
    endfor
  endif
  if responsive_grid
    assign show_columns_switcher = false
  endif
  assign sort_by = results.sort_by | default: results.default_sort_by
  assign sort_by_name = 'collections.sorting.title' | t
  assign show_sale_toggle = false
  assign sale_value = blank
  assign quick_tag_values = blank
  if template.name == 'collection' and st.filters_type == 'storefront_filters' and st.show_sorting
    assign show_sale_toggle = true
    for filter in results.filters
      if filter.param_name == 'filter.p.tag'
        if responsive_grid
          assign quick_tag_values = filter.values | sort: 'count' | reverse
        endif
        assign sale_value = filter.values | where: 'value', 'Sale' | first
        if sale_value == blank
          assign sale_value = filter.active_values | where: 'value', 'Sale' | first
        endif
        break
      endif
    endfor
  endif
  assign collection_title = results.title | default: collection.title | downcase
  if collection_title contains 'new arrivals'
    assign show_sale_toggle = false
  endif
  assign removed_sorts = 'manual,best-selling,title-ascending,title-descending,created-ascending' | split: ','
  for option in results.sort_options
    if template.name == 'collection' and removed_sorts contains option.value
      continue
    endif
    if option.value == sort_by
      assign sort_by_name = option.name | escape
      if template.name == 'collection' and option.value == 'created-descending'
        assign sort_by_name = 'Newest first'
      endif
      break
    endif
  endfor
-%}
{%- if show_sale_toggle -%}
  {%- capture sale_button -%}
    <button
      type="button"
      class="m-collection-sale-toggle"
      data-sale-filter-toggle
      data-filter-param="filter.p.tag"
      data-filter-value="Sale"
      aria-pressed="{% if sale_value.active %}true{% else %}false{% endif %}"
      {% if sale_value == blank %}
        disabled
      {% elsif sale_value.count == 0 and sale_value.active == false %}
        disabled
      {% endif %}
    >
      Sale
    </button>
  {%- endcapture -%}
{%- endif -%}
{%- capture quick_tag_buttons -%}
  {%- assign quick_tag_count = 0 -%}
  {%- for value in quick_tag_values -%}
    {%- assign normalized_tag = value.value | strip | downcase -%}
    {%- assign normalized_tag_label = value.label | strip | downcase -%}
    {%- if value.value == 'Sale' or normalized_tag == 'all' or normalized_tag_label == 'all' or value.active or value.count == 0 -%}
      {%- continue -%}
    {%- endif -%}
    <button
      type="button"
      class="m-collection-sale-toggle m-collection-tag-toggle"
      data-tag-filter-toggle
      data-filter-param="{{ value.param_name | escape }}"
      data-filter-value="{{ value.value | escape }}"
      aria-pressed="{% if value.active %}true{% else %}false{% endif %}"
    >
      {{- value.label | escape -}}
    </button>
    {%- assign quick_tag_count = quick_tag_count | plus: 1 -%}
    {%- if quick_tag_count == 5 -%}
      {%- break -%}
    {%- endif -%}
  {%- endfor -%}
{%- endcapture -%}
<div class="m-collection-toolbar{% if show_sale_toggle %} m-collection-toolbar--with-sale{% endif %}{% if responsive_grid %} m-collection-toolbar--grouped{% endif %}{% if mobile_refine %} m-collection-toolbar--refine{% endif %}">
  <div class="m-collection-toolbar--wrapper">
    <div class="m-toolbar--left m:flex{% unless sidebar_position == 'fixed' %} xl:m:hidden{% endunless %}">
      {%- if st.show_filter or mobile_refine and st.show_sorting -%}
        <button type="button" class="m-sidebar--open m:flex m:items-center{% unless st.show_filter %} md:m:hidden{% endunless %}">
          {% if mobile_refine %}
            <span class="md:m:hidden">Refine{% if active_filter_count > 0 %} ({{ active_filter_count }}){% endif %}</span>
            <span class="m:hidden md:m:block">Filters{% if active_filter_count > 0 %} ({{ active_filter_count }}){% endif %}</span>
          {% else %}
            <span>Filters{% if active_filter_count > 0 %} ({{ active_filter_count }}){% endif %}</span>
          {% endif %}
          <svg class="m-svg-icon--small" fill="currentColor" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 448 512">
            <path d="M441.9 167.3l-19.8-19.8c-4.7-4.7-12.3-4.7-17 0L224 328.2 42.9 147.5c-4.7-4.7-12.3-4.7-17 0L6.1 167.3c-4.7 4.7-4.7 12.3 0 17l209.4 209.4c4.7 4.7 12.3 4.7 17 0l209.4-209.4c4.7-4.7 4.7-12.3 0-17z"/>
          </svg>
        </button>
      {%- endif -%}
      {% if st.show_sorting and mobile_refine != true %}
        <button class="m-sortby--open md:m:hidden m:flex m:items-center">
          <span data-sortby-option>{{ sort_by_name }}</span>
          <svg class="m-svg-icon--small" fill="currentColor" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 448 512">
            <path d="M441.9 167.3l-19.8-19.8c-4.7-4.7-12.3-4.7-17 0L224 328.2 42.9 147.5c-4.7-4.7-12.3-4.7-17 0L6.1 167.3c-4.7 4.7-4.7 12.3 0 17l209.4 209.4c4.7 4.7 12.3 4.7 17 0l209.4-209.4c4.7-4.7 4.7-12.3 0-17z"/>
          </svg>
        </button>
      {% endif %}
      {% if show_sale_toggle or quick_tag_buttons != blank %}
        <div class="{% if responsive_grid %}m-toolbar--quick-filters{% else %}md:m:hidden{% endif %}">{{ sale_button }}{{ quick_tag_buttons }}</div>
      {% endif %}
    </div>
    {%- if st.show_sorting or show_columns_switcher -%}
      <div class="m-toolbar--right m:flex m:flex-1 m:items-center m:justify-end md:m:justify-between">
        {% if st.show_sorting %}
          <div class="m-toolbar--sortby m:hidden md:m:block" data-toolbar-sorting>
            <m-select-component>
              {%- assign sort_by = results.sort_by | default: results.default_sort_by -%}
              <select name="sort_by" aria-describedby="a11y-refresh-page-message" class="js-selectNative">
                {%- render 'product-sort-options', results: results, format: 'native' -%}
              </select>
              <div class="m-select-custom js-selectCustom" aria-hidden="true">
                <div class="m-select-custom--trigger">
                  <span class="m-select-custom--trigger-text"></span>
                  <span class="m-select-custom--trigger-icon">
                    <svg fill="currentColor" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 448 512">
                      <path d="M441.9 167.3l-19.8-19.8c-4.7-4.7-12.3-4.7-17 0L224 328.2 42.9 147.5c-4.7-4.7-12.3-4.7-17 0L6.1 167.3c-4.7 4.7-4.7 12.3 0 17l209.4 209.4c4.7 4.7 12.3 4.7 17 0l209.4-209.4c4.7-4.7 4.7-12.3 0-17z"/>
                    </svg>
                  </span>
                </div>
                <div class="m-select-custom--options m-select-custom--options-{{ pos }}">
                  {%- render 'product-sort-options', results: results, format: 'custom' -%}
                </div>
              </div>
            </m-select-component>
          </div>
        {% endif %}
        {% if show_sale_toggle and responsive_grid != true %}
          <div class="m:hidden md:m:block">{{ sale_button }}</div>
        {% endif %}
        {% if show_columns_switcher %}
          <div class="m-toolbar--column-switcher m:flex">
            <button class="m:flex m-tooltip m-tooltip--top" data-column="1" aria-label="1-column">
              <svg
                class="m-svg-icon--small"
                fill="currentColor"
                xmlns="http://www.w3.org/2000/svg"
                viewBox="0 0 12.5 9.5"
              >
                <path id="Rectangle" d="M12.5.75a.76.76 0 01-.75.75h-11A.76.76 0 010 .75.76.76 0 01.75 0h11a.76.76 0 01.75.75z" class="cls-1"/><path id="Rectangle-2" d="M12.5 4.75a.76.76 0 01-.75.75h-11A.76.76 0 010 4.75.76.76 0 01.75 4h11a.76.76 0 01.75.75z" class="cls-1" data-name="Rectangle"/><path id="Rectangle-3" d="M12.5 8.75a.76.76 0 01-.75.75h-11A.76.76 0 010 8.75.76.76 0 01.75 8h11a.76.76 0 01.75.75z" class="cls-1" data-name="Rectangle"/>
              </svg>
              <span class="m-tooltip__content">{{ 'collections.toolbar.view_list' | t }}</span>
            </button>
            <button class="m:flex m-tooltip m-tooltip--top" data-column="2" aria-label="2-column">
              <svg
                class="m-svg-icon--small"
                fill="currentColor"
                xmlns="http://www.w3.org/2000/svg"
                viewBox="0 0 5.5 12.5"
              >
                <path id="Rectangle" d="M.75 0a.76.76 0 01.75.75v11a.76.76 0 01-.75.75.76.76 0 01-.75-.75v-11A.76.76 0 01.75 0z" class="cls-1"/><path id="Rectangle-2" d="M4.75 0a.76.76 0 01.75.75v11a.76.76 0 01-.75.75.76.76 0 01-.75-.75v-11A.76.76 0 014.75 0z" class="cls-1" data-name="Rectangle"/></g></g></g></g>
              </svg>
              <span class="m-tooltip__content">{{ 'collections.toolbar.grid_2cloumns' | t }}</span>
            </button>
            <button class="m:hidden md:m:flex m-tooltip m-tooltip--top" data-column="3" aria-label="3-column">
              <svg
                class="m-svg-icon--small"
                fill="currentColor"
                xmlns="http://www.w3.org/2000/svg"
                viewBox="0 0 9.5 12.5"
              >
                <path id="Rectangle" d="M.75 0a.76.76 0 01.75.75v11a.76.76 0 01-.75.75.76.76 0 01-.75-.75v-11A.76.76 0 01.75 0z" class="cls-1"/><path id="Rectangle-2" d="M4.75 0a.76.76 0 01.75.75v11a.76.76 0 01-.75.75.76.76 0 01-.75-.75v-11A.76.76 0 014.75 0z" class="cls-1" data-name="Rectangle"/><path id="Rectangle-3" d="M8.75 0a.76.76 0 01.75.75v11a.76.76 0 01-.75.75.76.76 0 01-.75-.75v-11A.76.76 0 018.75 0z" class="cls-1" data-name="Rectangle"/>
              </svg>
              <span class="m-tooltip__content">{{ 'collections.toolbar.grid_3cloumns' | t }}</span>
            </button>
            <button class="m:hidden md:m:flex m-tooltip m-tooltip--top" data-column="4" aria-label="4-column">
              <svg
                class="m-svg-icon--small"
                fill="currentColor"
                xmlns="http://www.w3.org/2000/svg"
                viewBox="0 0 13.5 12.5"
              >
                <path id="Rectangle" d="M.75 0a.76.76 0 01.75.75v11a.76.76 0 01-.75.75.76.76 0 01-.75-.75v-11A.76.76 0 01.75 0z" class="cls-1"/><path id="Rectangle-2" d="M4.75 0a.76.76 0 01.75.75v11a.76.76 0 01-.75.75.76.76 0 01-.75-.75v-11A.76.76 0 014.75 0z" class="cls-1" data-name="Rectangle"/><path id="Rectangle-3" d="M8.75 0a.76.76 0 01.75.75v11a.76.76 0 01-.75.75.76.76 0 01-.75-.75v-11A.76.76 0 018.75 0z" class="cls-1" data-name="Rectangle"/><path id="Rectangle-4" d="M12.75 0a.76.76 0 01.75.75v11a.76.76 0 01-.75.75.76.76 0 01-.75-.75v-11a.76.76 0 01.75-.75z" class="cls-1" data-name="Rectangle"/>
              </svg>
              <span class="m-tooltip__content">{{ 'collections.toolbar.grid_4cloumns' | t }}</span>
            </button>
            <button class="m:hidden lg:m:flex m-tooltip m-tooltip--top" data-column="5" aria-label="5-column">
              <svg
                class="m-svg-icon--small"
                fill="currentColor"
                xmlns="http://www.w3.org/2000/svg"
                viewBox="0 0 17.5 12.5"
              >
                <path id="Rectangle" d="M.75 0a.76.76 0 01.75.75v11a.76.76 0 01-.75.75.76.76 0 01-.75-.75v-11A.76.76 0 01.75 0z" class="cls-1"/><path id="Rectangle-2" d="M4.75 0a.76.76 0 01.75.75v11a.76.76 0 01-.75.75.76.76 0 01-.75-.75v-11A.76.76 0 014.75 0z" class="cls-1" data-name="Rectangle"/><path id="Rectangle-3" d="M8.75 0a.76.76 0 01.75.75v11a.76.76 0 01-.75.75.76.76 0 01-.75-.75v-11A.76.76 0 018.75 0z" class="cls-1" data-name="Rectangle"/><path id="Rectangle-4" d="M12.75 0a.76.76 0 01.75.75v11a.76.76 0 01-.75.75.76.76 0 01-.75-.75v-11a.76.76 0 01.75-.75z" class="cls-1" data-name="Rectangle"/><path id="Rectangle-5" d="M16.75 0a.76.76 0 01.75.75v11a.76.76 0 01-.75.75.76.76 0 01-.75-.75v-11a.76.76 0 01.75-.75z" class="cls-1" data-name="Rectangle"/>
              </svg>
              <span class="m-tooltip__content">{{ 'collections.toolbar.grid_5cloumns' | t }}</span>
            </button>
          </div>
        {% endif %}
      </div>
    {%- endif -%}
  </div>
</div>
