{%- capture uber_message -%}
{{ shop.url }}{{ product.url }}
Hi, I'd like to enquire Uber same-day delivery on this product.
{%- endcapture -%}

<pickup-availability-drawer
  id="Drawer-Uber-Delivery"
  class="m-drawer m-uber-delivery-drawer"
  role="dialog"
  aria-modal="true"
  aria-labelledby="UberDeliveryHeading"
>
  <div class="m-drawer__wrapper m:hidden" style="--m-bg-opacity: 0;">
    <div
      class="m-drawer__content m:h-full m:flex m:flex-col m-gradient m-color-{{ settings.drawer_popup_color_scheme }}"
      tabindex="-1"
    >
      <div class="m-drawer__header">
        <h3 class="m-drawer__title m:text-xl md:m:text-2xl m:font-medium" id="UberDeliveryHeading">
          Uber same-day delivery
        </h3>
        <button type="button" class="m-drawer__close" aria-label="{{ 'general.accessibility.close' | t }}">
          <svg class="m-svg-icon--large" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true" focusable="false">
            <path d="m6 6 12 12M6 18 18 6"/>
          </svg>
        </button>
      </div>
      <div class="m-drawer__body m-scrollbar--vertical m:flex-1">
        <p class="m-uber-delivery-drawer__product">{{ product.title | escape }}</p>
        <p class="m-uber-delivery-drawer__description">
          Uber Same-day delivery is available in metro Melbourne. Contact us via phone (03 9662 2008), WhatsApp, or Instagram DM to arrange. Delivery time confirmed on request.
        </p>
        <div class="m-uber-delivery-drawer__actions">
          <a class="m-uber-delivery-drawer__action m-uber-delivery-drawer__action--call" href="tel:+61396622008">
            Call now
          </a>
          <a class="m-uber-delivery-drawer__action" href="https://ig.me/m/lestyleboutique" target="_blank" rel="noopener">
            Instagram DM
          </a>
          <a
            class="m-uber-delivery-drawer__action m-uber-delivery-drawer__action--whatsapp"
            href="https://wa.me/61492266452?text={{ uber_message | url_encode | escape }}"
            target="_blank"
            rel="noopener"
          >
            WhatsApp
          </a>
        </div>
      </div>
    </div>
  </div>
</pickup-availability-drawer>
