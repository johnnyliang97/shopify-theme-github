{%- liquid
  assign selected_variant = product.selected_or_first_available_variant
  if use_variant
    assign target = selected_variant
  else
    assign target = product
  endif

  assign compare_at_price = target.compare_at_price
  assign price = target.price | default: 1999

  if is_product_card and settings.pcard_show_lowest_prices
    assign price = product.price
    assign compare_at_price = product.compare_at_price
  endif

  assign available = target.available | default: false
  assign money_price = price | money
  assign price_min = product.price_min
  assign price_max = product.price_max
  assign money_price_min = price_min | money
  assign money_price_max = price_max | money

  if settings.currency_code_enabled
    assign money_price = price | money_with_currency
    assign money_price_min = price_min | money_with_currency
    assign money_price_max = price_max | money_with_currency
  endif

  if is_product_card
    assign display_price = price | divided_by: 100.0 | ceil | times: 100
    assign display_compare_at_price = compare_at_price | default: 0 | divided_by: 100.0 | ceil | times: 100
    assign display_price_min = price_min | divided_by: 100.0 | ceil | times: 100
    assign display_price_max = price_max | divided_by: 100.0 | ceil | times: 100
    assign money_price = display_price | money_without_trailing_zeros
    assign money_compare_at_price = display_compare_at_price | money_without_trailing_zeros
    assign money_price_min = display_price_min | money_without_trailing_zeros
    assign money_price_max = display_price_max | money_without_trailing_zeros
    if settings.currency_code_enabled
      assign currency_code = cart.currency.iso_code | default: shop.currency
      assign money_price = money_price | append: ' ' | append: currency_code
      assign money_compare_at_price = money_compare_at_price | append: ' ' | append: currency_code
      assign money_price_min = money_price_min | append: ' ' | append: currency_code
      assign money_price_max = money_price_max | append: ' ' | append: currency_code
    endif
  endif

  if target == product and product.price_varies and settings.pcard_show_lowest_prices
    assign money_price = 'products.product.from_text_html' | t: price: money_price
  endif

  assign sale_badge_type = sale_badge_type | default: 'percentage'
  assign show_plain_percentage = false
  if plain_percentage and sale_badge_type == 'percentage'
    assign show_plain_percentage = true
  endif
  assign card_discount = 0
  if is_product_card and compare_at_price > price
    assign card_discount = compare_at_price | minus: price | times: 100.0 | divided_by: compare_at_price
    assign card_discount = card_discount | divided_by: 5.0 | round | times: 5 | at_least: 5
  endif
-%}

<div
  class="
    m-price m:inline-flex m:items-center m:flex-wrap
    {%- if is_product_card %} m-price--card{% endif -%}
    {%- if alignment %} m-price--{{ alignment }}{% endif -%}
    {%- if price_class %} {{ price_class }}{% endif -%}
    {%- if available == false %} m-price--sold-out {% endif -%}
    {%- if compare_at_price > price %} m-price--on-sale {% endif -%}
    {%- if target.price_varies == false and target.compare_at_price_varies %} m-price--no-compare{% endif -%}
  "
  data-sale-badge-type="{{ sale_badge_type }}"
>
  <div class="m-price__regular">
    {%- if product.quantity_price_breaks_configured? -%}
      <span class="m:visually-hidden m:visually-hidden--inline">{{ 'products.product.price.regular_price' | t }}</span>
      <span class="m-price-item m-price-item--regular {{ price_text_size }}">
        {%- render 'new-locale',
          key: 'products.product.volume_pricing.price_range_html',
          param: '{{ minimum }}',
          value: money_price_min,
          param_2: '{{ maximum }}',
          value_2: money_price_max
        -%}
      </span>
    {%- else -%}
      <span class="m:visually-hidden m:visually-hidden--inline">{{ 'products.product.price.regular_price' | t }}</span>
      <span class="m-price-item m-price-item--regular {{ price_text_size }}">
        {{ money_price }}
      </span>
    {%- endif -%}
  </div>
  <div class="m-price__sale">
    <span class="m:visually-hidden m:visually-hidden--inline">{{ 'products.product.price.sale_price' | t }}</span>
    <span class="m-price-item m-price-item--sale m-price-item--last {{ price_text_size }}">
      {{ money_price }}
    </span>
    {%- unless target.price_varies == false and target.compare_at_price_varies %}
      <span class="m:visually-hidden m:visually-hidden--inline">{{ 'products.product.price.regular_price' | t }}</span>
      <s class="m-price-item m-price-item--regular">
        {% if is_product_card %}
          {{ money_compare_at_price }}
        {% elsif settings.currency_code_enabled %}
          {{ compare_at_price | money_with_currency }}
        {% else %}
          {{ compare_at_price | money }}
        {% endif %}
      </s>
    {%- endunless -%}
  </div>
  {% if is_product_card %}
    <span class="m-price__card-discount" data-card-discount>-{{ card_discount }}%</span>
  {% endif %}
  <div class="m-price__unit-wrapper{% if selected_variant.unit_price_measurement == nil %} m:hidden{% endif %}">
    <span class="m:visually-hidden">{{ 'products.product.price.unit_price' | t }}</span>
    <div class="m-price__unit">
      {%- capture unit_price_separator -%}
        <span aria-hidden="true">/</span>
      {%- endcapture -%}
      {%- capture unit_price_base_unit -%}
        <span data-unit-price-base-unit>
            {%- if selected_variant.unit_price_measurement -%}
              {%- if selected_variant.unit_price_measurement.reference_value != 1 -%}
                {{- selected_variant.unit_price_measurement.reference_value -}}
              {%- endif -%}
              {{ selected_variant.unit_price_measurement.reference_unit }}
            {%- endif -%}
          </span>
      {%- endcapture -%}
      <span data-unit-price>{{ selected_variant.unit_price | money }}</span>
      {{- unit_price_separator -}}
      {{- unit_price_base_unit -}}
    </div>
  </div>

  {% if show_sale_badge %}
    <div class="m-price__badges{% if show_plain_percentage %} m-price__badges--plain{% endif %}">
      {% if show_sale_badge %}
        {% liquid
          assign save_amount = 0
          if compare_at_price > price
            assign save_amount = compare_at_price | minus: price
          endif

          assign discount = ''
          if sale_badge_type == 'percentage'
            assign discount_percent = save_amount | times: 100.0 | divided_by: compare_at_price
            assign discount_percent = discount_percent | divided_by: 5.0 | round | times: 5
            if discount_percent < 5
              assign discount_percent = 5
            endif
            assign discount = discount_percent | append: '% OFF'
            if show_plain_percentage
              assign discount = discount_percent | prepend: '-' | append: '%'
            endif
          elsif sale_badge_type == 'fixed_amount'
            if settings.currency_code_enabled
              assign discount = save_amount | money_with_currency
            else
              assign discount = save_amount | money
            endif
          endif
        %}
        <div class="m-price__badge-sale" data-type="{{ sale_badge_type }}">
          <span class="{% if show_plain_percentage %}m-price__discount-text{% else %}m-product-tag m-product-tag--sale m-gradient m-color-{{ settings.sale_badge_color_scheme }}{% endif %}">
            {% unless sale_badge_type == 'text' %}
              {{ discount }}
            {% else %}
              {% render 'new-locale', key: 'products.product.sale_text' %}
            {% endunless %}
          </span>
        </div>
      {% endif %}
    </div>
  {% endif %}
</div>
